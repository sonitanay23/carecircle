{
  "name": "carecircle",
  "version": "0.1.0",
  "description": "CareCircle: elderly care and medication management platform where the elder stays in charge.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-reporter=spec 'test/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'test/**/*.test.js'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "node --test test/e2e/ui.e2e.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "compression": "^1.8.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "nodemailer": "^10.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "globals": "^16.3.0",
    "playwright": "^1.55.0",
    "prettier": "^3.6.0"
  },
  "license": "MIT"
}
