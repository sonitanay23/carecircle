# Copy to .env for local development. In Cloud Run, secrets come from Secret Manager.
PORT=8080
NODE_ENV=development
LOG_LEVEL=info
# Public URL of the deployed app (used in email links)
APP_BASE_URL=http://localhost:8080
# memory (default locally) or firestore (default in production)
STORE=memory
# Required in production: 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=
SESSION_TTL_HOURS=12
GOOGLE_CLOUD_PROJECT=

# --- Reminders ---
# Email: Gmail with an app password (Google Account > Security > App passwords)
MAIL_TRANSPORT=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Secret Cloud Scheduler sends in the X-Cron-Secret header (24+ chars)
CRON_SECRET=
REMINDER_LEAD_MINUTES=10
MISSED_AFTER_MINUTES=60
ESCALATE_AFTER_MINUTES=60

# --- AI (Gemini) ---
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Defaults to the newest Flash model; pin a version (e.g. gemini-3.8-flash) if you prefer
GEMINI_MODEL=gemini-flash-latest
# Cloud Translation + Text-to-Speech: automatic on Cloud Run (service account).
# Locally, an API key with both APIs enabled lets you try them.
GOOGLE_API_KEY=
